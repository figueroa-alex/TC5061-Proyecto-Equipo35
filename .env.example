# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PROYECTO MIBICI (EQUIPO 35)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo como '.env' en tu entorno local si deseas personalizar rutas:
#       cp .env.example .env
# 2. Nunca subas el archivo '.env' a Git (está bloqueado en .gitignore).
# 3. No guardes contraseñas reales, tokens ni llaves privadas en el código fuente.

# Servidor local de MLflow Tracking y Model Registry
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=mibici-equipo35

# URL pública oficial de datos abiertos de MiBici
MIBICI_OPEN_DATA_URL=https://mibici.net/es/datos-abiertos/

# Semilla global para reproducibilidad de entrenamientos y pruebas
MIBICI_RANDOM_SEED=42

# Modo de datos para las pruebas de DeepChecks:
#   auto      -> Usa muestra de datos reales (Parquet) si existen; si no, usa datos sintéticos
#   real      -> Fuerza el uso de la muestra del archivo Parquet real
#   synthetic -> Fuerza el uso del dataset sintético de respaldo (rápido / clon limpio)
MIBICI_TEST_DATA_MODE=auto

# Configuración del servicio API REST (FastAPI) y recuperación desde el Model Registry
# Dentro de un contenedor Podman, para conectarse al servidor MLflow del host usa:
#   MLFLOW_TRACKING_URI=http://host.containers.internal:5000
MIBICI_MODEL_ALIAS=champion
MIBICI_MODEL_VERSION=2
MIBICI_MODEL_LOAD_MODE=hybrid
MIBICI_API_HOST=0.0.0.0
MIBICI_API_PORT=8000